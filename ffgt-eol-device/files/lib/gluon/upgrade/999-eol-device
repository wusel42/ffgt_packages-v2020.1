#!/bin/sh

N1="$(get_image_name)"

RC1="$(awk -v name="${N1:-unknown}" </lib/gluon/eol-devices 'BEGIN{found=0;} {if($1==name) found=1;} END{printf("%d", found);}')"
branch="$(uci get autoupdater.settings.branch)"

# We have a match
if [ $RC1 -eq 1 ]; then
  if [ "${branch}" != "deadend" ]; then
    uci set autoupdater.settings.branch='deadend'
    uci commit autoupdater
  fi
fi

branch="$(uci get autoupdater.settings.branch)"
if [ "${branch}" = "deadend" ]; then
  HOSTNAME="$(uci get system.@system[0].hostname | sed -e 's/-EOL$//')"
  uci set system.@system[0].hostname="${HOSTNAME}-EOL"
  uci commit system
fi
